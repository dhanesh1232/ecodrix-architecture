  "accessibility": {
    "contrastRatios": {
      "primary-on-white": {
        "ratio": "4.65:1",
        "AA": true,
        "AAA": false,
        "note": "Passes AA (4.5:1 min). Fails AAA (7:1 min). Acceptable for UI components."
      },
      "accent-on-white": {
        "ratio": "5.91:1",
        "AA": true,
        "AAA": false,
        "note": "Passes AA. Comfortable margin. Use for badges and secondary CTAs."
      },
      "fire-on-white": {
        "ratio": "4.55:1",
        "AA": true,
        "AAA": false,
        "note": "Borderline AA. Only for large text (18px+) or UI components, not body."
      },
      "white-on-primary": {
        "ratio": "4.65:1",
        "AA": true,
        "AAA": false,
        "note": "White text on #2563EB buttons — passes AA. Use font-weight 600 minimum."
      },
      "white-on-accent": {
        "ratio": "5.91:1",
        "AA": true,
        "AAA": false,
        "note": "White text on #7C3AED buttons — comfortable AA pass."
      },
      "white-on-fire": {
        "ratio": "4.55:1",
        "AA": true,
        "AAA": false,
        "note": "White text on #DC2626 — borderline. Use font-weight 600 minimum."
      },
      "ink-on-white": {
        "ratio": "18.1:1",
        "AA": true,
        "AAA": true,
        "note": "#0F172A on white — AAA. Primary text always passes."
      },
      "ink-on-dark-canvas": {
        "ratio": "17.2:1",
